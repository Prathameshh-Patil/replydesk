# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
# Every variable the project uses is listed here, with a comment saying what it is for.

# Where the app is running: local, test or production.
ENVIRONMENT=local

# PostgreSQL user, password and database name used by docker-compose to create the local database.
POSTGRES_USER=replydesk
POSTGRES_PASSWORD=replydesk
POSTGRES_DB=replydesk

# Ports on your laptop for the database and the API (chosen to avoid clashing with other projects).
DB_PORT=5442
API_PORT=8010

# How the API connects to PostgreSQL (SQLAlchemy URL). From your laptop the host is localhost;
# inside docker-compose it is overridden to use the host name "db".
DATABASE_URL=postgresql+psycopg://replydesk:replydesk@localhost:5442/replydesk

# Secret that signs login tokens. Anyone who knows it can log in as anyone, so in production use
# a long random value, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-please

# How long a login lasts, in minutes (480 = 8 hours).
JWT_EXPIRE_MINUTES=480

# Agents: "llm" calls the model below; "fake" returns canned answers (tests, offline demos).
AGENT_CLIENT=llm

# Any OpenAI-compatible chat API. We use Gemini (free key: https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Secret: your Gemini API key. Only ever in .env, never committed.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# How much the model "thinks" before answering: low is faster and cheaper.
LLM_REASONING_EFFORT=low
# Seconds to wait for one agent reply before counting it as failed.
LLM_TIMEOUT_SECONDS=60
