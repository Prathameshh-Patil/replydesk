# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
# Every variable the project uses is listed here, with a comment saying what it is for.

# Where the app is running: local, test or production.
ENVIRONMENT=local

# PostgreSQL user, password and database name used by docker-compose to create the local database.
POSTGRES_USER=replydesk
POSTGRES_PASSWORD=replydesk
POSTGRES_DB=replydesk

# Ports on your laptop for the database and the API (chosen to avoid clashing with other projects).
DB_PORT=5442
API_PORT=8010

# How the API connects to PostgreSQL (SQLAlchemy URL). From your laptop the host is localhost;
# inside docker-compose it is overridden to use the host name "db".
DATABASE_URL=postgresql+psycopg://replydesk:replydesk@localhost:5442/replydesk
